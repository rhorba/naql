{
  "name": "naql",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @naql/db db:generate",
    "db:migrate": "pnpm --filter @naql/db db:migrate",
    "db:push": "pnpm --filter @naql/db db:push",
    "db:studio": "pnpm --filter @naql/db db:studio",
    "db:seed": "pnpm --filter @naql/db db:seed",
    "type-check": "tsc --build --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
