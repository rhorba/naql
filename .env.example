# =============================================================================
# Naql — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================================

# --- Database ---
# Migration owner (used by drizzle-kit only)
DATABASE_URL=postgresql://naql_owner:CHANGE_ME@localhost:5432/naql

# App runtime (RLS-bound naql_app role)
DATABASE_APP_URL=postgresql://naql_app:CHANGE_ME@localhost:5432/naql

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# --- OCR (Sprint 5) ---
GOOGLE_VISION_API_KEY=
AWS_TEXTRACT_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Mobile API URL (for Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- pg-boss worker ---
WORKER_DATABASE_URL=${DATABASE_APP_URL}

# --- Misc ---
NODE_ENV=development
